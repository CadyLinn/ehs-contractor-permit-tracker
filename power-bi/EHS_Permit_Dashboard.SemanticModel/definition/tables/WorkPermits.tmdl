table WorkPermits
	lineageTag: 640db737-3a8a-47a9-9dfe-3bb487b05a12

	measure 'Permit Count' = COUNTROWS ( WorkPermits )
		formatString: 0
		lineageTag: c090e6e8-b445-4771-9498-b96cc2cb7c96

	measure 'Active Permits' = CALCULATE ( COUNTROWS ( WorkPermits ), WorkPermits[Status] IN { "Approved", "In Progress" } )
		formatString: 0
		lineageTag: c03e8a4b-ea9b-4cf8-b86b-b73c44a1ea3e

	measure 'Pending Review' = CALCULATE ( COUNTROWS ( WorkPermits ), WorkPermits[Status] IN { "Submitted", "EHS Review" } )
		formatString: 0
		lineageTag: 58927412-9913-4e56-b8e1-1d6b6b8ba91f

	measure 'Overdue Permits' =
			CALCULATE (
			    COUNTROWS ( WorkPermits ),
			    WorkPermits[EndDate] < TODAY (),
			    NOT ( WorkPermits[Status] IN { "Closed", "Rejected" } )
			)
		formatString: 0
		lineageTag: a68121a2-9f0f-4f14-a525-13bfba93f689

	measure 'High-Risk Work Today' =
			CALCULATE (
			    COUNTROWS ( WorkPermits ),
			    WorkPermits[RiskLevel] = "High",
			    WorkPermits[StartDate] <= TODAY (),
			    WorkPermits[EndDate] >= TODAY (),
			    WorkPermits[Status] IN { "Approved", "In Progress" }
			)
		formatString: 0
		lineageTag: e8e7cda1-4161-4790-a0d9-2506d4cdcb2b

	measure 'Days Overdue' =
			VAR e = MAX ( WorkPermits[EndDate] )
			VAR s = MAX ( WorkPermits[Status] )
			RETURN
			    IF ( NOT ISBLANK ( e ) && e < TODAY () && NOT ( s IN { "Closed", "Rejected" } ), INT ( TODAY () - e ) )
		formatString: 0
		lineageTag: 6c6898ee-1f08-4dd8-9075-1ee7b0a145a2

	column PermitNo
		dataType: string
		lineageTag: 710030ba-8ee3-4ecd-a0e2-b5cbed46c920
