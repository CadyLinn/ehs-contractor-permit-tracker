	partition WorkPermits = m
		mode: import
		source =
				let
				    Source = SharePoint.Tables("https://YOUR-TENANT.sharepoint.com/sites/YOUR-SITE", [ApiVersion = 15]),
				    Items = Source{[Title = "WorkPermits"]}[Items],
				    Named = Table.RenameColumns(Items, {{"field_1", "Contractor"}, {"field_2", "Area"}, {"field_3", "WorkType"}, {"field_4", "RiskLevel"}, {"field_5", "StartDate"}, {"field_6", "EndDate"}, {"field_7", "Workers"}, {"field_8", "SafetyChecklist"}, {"field_9", "Status"}}, MissingField.Ignore),
				    Picked = Table.SelectColumns(Named, {"Id", "Title", "Contractor", "Area", "WorkType", "RiskLevel", "StartDate", "EndDate", "Workers", "SafetyChecklist", "Status"}, MissingField.UseNull),
				    ToLocalDate = (v) => if v = null then null else Date.From(DateTimeZone.SwitchZone(DateTime.AddZone(DateTime.From(v), 0), 8)),
				    Dated = Table.TransformColumns(Picked, {{"StartDate", ToLocalDate, type date}, {"EndDate", ToLocalDate, type date}}),
				    WithNo = Table.AddColumn(Dated, "PermitNo", each "WP-" & Text.PadStart(Text.From([Id]), 4, "0"), type text),
				    Typed = Table.TransformColumnTypes(WithNo, {{"Title", type text}, {"Contractor", type text}, {"Area", type text}, {"WorkType", type text}, {"RiskLevel", type text}, {"Workers", Int64.Type}, {"SafetyChecklist", type text}, {"Status", type text}}),
				    Result = Table.SelectColumns(Typed, {"PermitNo", "Title", "Contractor", "Area", "WorkType", "RiskLevel", "StartDate", "EndDate", "Workers", "SafetyChecklist", "Status"})
				in
				    Result

	annotation PBI_ResultType = Table

