	column Comment
		dataType: string
		lineageTag: 9acc984c-6137-45a3-a354-ad7363b2781b
		summarizeBy: none
		sourceColumn: Comment

	column ChangedAt
		dataType: dateTime
		formatString: yyyy/mm/dd
		lineageTag: 6408e98d-ffce-4dc5-85e2-b027138a51c3
		summarizeBy: none
