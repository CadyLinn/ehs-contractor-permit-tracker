	partition StatusLog = m
		mode: import
		source =
				let
				    Source = SharePoint.Tables("https://YOUR-TENANT.sharepoint.com/sites/YOUR-SITE", [ApiVersion = 15]),
				    Items = Source{[Title = "StatusLog"]}[Items],
				    Picked = Table.SelectColumns(Items, {"Title", "FromStatus", "ToStatus", "Comment", "Created"}, MissingField.UseNull),
				    Renamed = Table.RenameColumns(Picked, {{"Title", "PermitNo"}, {"Created", "ChangedAt"}}),
				    Local = Table.TransformColumns(Renamed, {{"ChangedAt", (v) => if v = null then null else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTime.AddZone(DateTime.From(v), 0), 8)), type datetime}}),
				    Typed = Table.TransformColumnTypes(Local, {{"PermitNo", type text}, {"FromStatus", type text}, {"ToStatus", type text}, {"Comment", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

